{
  "name": "@hyker/xlsx-to-js",
  "private": true,
  "version": "2.0.0",
  "description": "HYKER's hardened fork of xlsx-to-js: bounded, cancellable XLSX parsing and HTML previews for untrusted workbooks",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev:demo": "npm --prefix examples/vite run dev",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && playwright test",
    "test:xml-worker": "npm run build && XLSX_XML_PARSER=xmldom node --test tests/*.test.mjs",
    "pack:vendor": "npm pack --pack-destination vendor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyker/xlsx-to-js.git"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "xlsx-parser"
  ],
  "author": "Javier Mora",
  "contributors": [
    "HYKER (https://github.com/hyker)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hyker/xlsx-to-js/issues"
  },
  "homepage": "https://github.com/hyker/xlsx-to-js#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^2.1.7",
    "cross-spawn": "7.0.6",
    "diff": "4.0.4",
    "glob": "10.5.0",
    "minimatch": "9.0.7",
    "esbuild": "$esbuild"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.1"
  }
}
